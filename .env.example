# Supabase (dev 프로젝트) — 실제 값은 .env.local 에 두고 커밋하지 않는다.
# .gitignore 가 .env* 를 막고 있으므로 이 예시 파일만 저장소에 남는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 클라이언트에 노출되므로 금지.
SUPABASE_SERVICE_ROLE_KEY=

# 카페24 외부몰 연동 (Stage 5) — 아직 미사용
# CAFE24_MALL_ID=
# CAFE24_CLIENT_ID=
# CAFE24_CLIENT_SECRET=
